FROM node:22-alpine AS build
ARG APP=web
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SOCKET_URL
ARG NEXT_PUBLIC_WEB_URL
ARG NEXT_PUBLIC_SELLER_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SOCKET_URL=${NEXT_PUBLIC_SOCKET_URL}
ENV NEXT_PUBLIC_WEB_URL=${NEXT_PUBLIC_WEB_URL}
ENV NEXT_PUBLIC_SELLER_URL=${NEXT_PUBLIC_SELLER_URL}
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/seller/package.json ./apps/seller/package.json
COPY apps/admin/package.json ./apps/admin/package.json
COPY services/api/package.json ./services/api/package.json
RUN npm ci --no-audit --no-fund
# Seller/admin import shared media code; seller also imports the web mannequin.
COPY apps/ ./apps/
COPY shared/ ./shared/
RUN npm --workspace apps/${APP} run build

FROM node:22-alpine AS runtime
ARG APP=web
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/seller/package.json ./apps/seller/package.json
COPY apps/admin/package.json ./apps/admin/package.json
COPY services/api/package.json ./services/api/package.json
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /app/apps/${APP}/.next ./apps/${APP}/.next
COPY --from=build /app/apps/${APP}/public ./apps/${APP}/public
COPY --from=build /app/apps/${APP}/next.config.mjs ./apps/${APP}/next.config.mjs
WORKDIR /app/apps/${APP}
USER node
EXPOSE 3000
CMD ["npm","run","start","--","-p","3000"]
