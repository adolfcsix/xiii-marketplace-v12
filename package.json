{
  "name": "xiii-marketplace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,seller,admin -c auto \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:seller\" \"npm:dev:admin\"",
    "dev:api": "npm --workspace services/api run start:dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:seller": "npm --workspace apps/seller run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:phase1": "node tools/verify-phase1.mjs",
    "verify:payment": "node tools/verify-payment.mjs",
    "verify:orders": "node tools/verify-orders.mjs",
    "verify:seller-orders": "node tools/verify-seller-orders.mjs",
    "verify:seller-catalog": "node tools/verify-seller-catalog.mjs",
    "verify:admin-products": "node tools/verify-admin-product-review.mjs",
    "verify:after-sales": "node tools/verify-after-sales.mjs",
    "verify:reviews": "node tools/verify-reviews.mjs",
    "verify:realtime": "node tools/verify-realtime.mjs",
    "verify:finance": "node tools/verify-finance.mjs",
    "verify:promotions": "node tools/verify-promotions.mjs",
    "verify:analytics": "node tools/verify-analytics.mjs",
    "verify:cms": "node tools/verify-cms.mjs",
    "verify:access": "node tools/verify-access-control.mjs",
    "verify:operations": "node tools/verify-operations-admin.mjs",
    "verify:admin-ops-settings": "node tools/verify-admin-ops-settings.mjs",
    "verify:hardening": "node tools/verify-production-hardening.mjs",
    "verify:runtime-readiness": "node tools/verify-runtime-readiness.mjs",
    "runtime:preflight": "node tools/runtime-preflight.mjs",
    "runtime:smoke": "node tools/runtime-smoke.mjs",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:headed": "playwright test -c e2e/playwright.config.ts --headed",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:stack": "node tools/e2e-stack.mjs",
    "verify:e2e": "node tools/verify-e2e.mjs",
    "verify:staging": "node tools/verify-staging-deploy.mjs",
    "staging:preflight": "node tools/staging-preflight.mjs",
    "staging:smoke": "node tools/staging-smoke.mjs",
    "staging:deploy": "bash ops/staging/deploy.sh",
    "staging:rollback": "bash ops/staging/rollback.sh",
    "local:windows:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/preflight.ps1",
    "local:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start-local.ps1",
    "local:windows:diagnose": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/diagnose-local.ps1",
    "local:windows:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/stop-infra.ps1",
    "verify:windows-local": "node tools/verify-windows-local-runner.mjs",
    "verify:auth-session": "node tools/verify-auth-session.mjs",
    "test:regressions": "node --import tsx --test tests/regressions.test.ts",
    "test:schemas": "npm --workspace services/api run build && node --test tests/schema-regressions.cjs",
    "test:home": "node --import tsx --test tests/home-data.test.ts",
    "test:threeui": "node --import tsx --test tests/threeui-source.test.ts",
    "test:size": "node --import tsx --test tests/size-advice.test.ts",
    "test:uploads": "npm --workspace services/api run build && node --import tsx --test tests/image-upload.test.ts && node --test tests/storage-image-formats.cjs",
    "test:image-editor": "node --import tsx --test tests/image-editor.test.ts",
    "test:threeui-runtime": "node --import tsx --test tests/threeui-source.test.ts tests/threeui-runtime.test.ts",
    "test:realtime-auth": "npm --workspace services/api run build && node --test tests/realtime-auth.cjs",
    "test:live": "node --test tests/live-regressions.cjs",
    "test:seed": "node --test tests/seed-idempotency.cjs",
    "test:ai-artwork": "npm --workspace services/api run build && node --test tests/ai-artwork.cjs tests/production-config.cjs tests/schema-regressions.cjs",
    "test:commerce": "npm --workspace services/api run build && node --test tests/commerce-concurrency.cjs",
    "test:outfit": "node --import tsx --test tests/outfit-appearance.test.ts tests/outfit-studio.test.ts",
    "test:public-catalog": "npm --workspace services/api run build && node --test tests/public-catalog.cjs",
    "test:inventory": "npm --workspace services/api run build && node --test tests/inventory-atomicity.cjs",
    "test:seller-variant": "node --import tsx --test tests/seller-variant.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@playwright/test": "^1.55.0",
    "next": "15.5.27",
    "tsx": "^4.20.5"
  },
  "overrides": {
    "postcss": "8.5.29",
    "shell-quote": "1.11.0",
    "sharp": "0.35.5"
  }
}
