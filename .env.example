NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
MONGODB_URI=mongodb://localhost:27017/xiii_marketplace?replicaSet=rs0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=2
REDIS_URL=redis://localhost:6379
REQUIRE_REDIS=true

# Replace with long random values before production.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
PAYOUT_ENCRYPTION_KEY=change-me-payout-encryption-key-at-least-32-chars

WEB_URL=http://localhost:3000
SELLER_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
API_PUBLIC_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SELLER_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional server-side Web API origin, including /api/v1 (e.g. Docker service URL).
# API_INTERNAL_URL=http://api:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
TRUST_PROXY=true
HTTP_JSON_LIMIT=1mb
HTTP_FORM_LIMIT=1mb
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

PAYMENT_EXPIRES_MINUTES=15

# Local dev object storage (MinIO from docker-compose.yml).
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=xiii-media
STORAGE_ACCESS_KEY_ID=xiii-minio
STORAGE_SECRET_ACCESS_KEY=xiii-minio-change-me
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/xiii-media
STORAGE_FORCE_PATH_STYLE=true
STORAGE_UPLOAD_URL_TTL_SECONDS=300

# MoMo Sandbox — lấy credential thật từ MoMo Business/Developer.
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REQUEST_TYPE=captureWallet

# VNPAY Sandbox — đăng ký merchant sandbox để lấy TmnCode + HashSecret.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# AI garment artwork pilot (server only; off until explicitly configured).
AI_OUTFIT_ENABLED=false
OPENAI_API_KEY=
AI_OUTFIT_MODEL=gpt-image-1.5
AI_OUTFIT_DAILY_LIMIT=10
