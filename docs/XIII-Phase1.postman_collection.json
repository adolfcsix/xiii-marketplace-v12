{
  "info": {
    "name": "XIII Marketplace - Phase 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "variantId",
      "value": ""
    },
    {
      "key": "addressId",
      "value": ""
    },
    {
      "key": "orderCode",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login seller",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seller@xiii.local\",\n  \"password\": \"Xiii12345!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j=pm.response.json(); if(j.data?.accessToken) pm.collectionVariables.set('accessToken', j.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/me"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Brands",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/brands"
          }
        },
        {
          "name": "Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products?page=1&limit=24"
          }
        }
      ]
    },
    {
      "name": "Seller",
      "item": [
        {
          "name": "My shop",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/seller/shop"
          }
        },
        {
          "name": "My products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/seller/products"
          }
        },
        {
          "name": "Inventory",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/seller/inventory"
          }
        }
      ]
    },
    {
      "name": "Checkout + Orders",
      "item": [
        {
          "name": "Login buyer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer@xiii.local\",\n  \"password\": \"Xiii12345!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j=pm.response.json(); if(j.data?.accessToken) pm.collectionVariables.set('accessToken', j.data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "List addresses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/me/addresses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j=pm.response.json(); if(j.data?.[0]?._id) pm.collectionVariables.set('addressId', j.data[0]._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Checkout preview",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": \"{{addressId}}\",\n  \"shippingMethod\": \"STANDARD\",\n  \"voucherCode\": \"XIII120\"\n}"
            },
            "url": "{{baseUrl}}/checkout/preview"
          }
        },
        {
          "name": "Create COD order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressId\": \"{{addressId}}\",\n  \"shippingMethod\": \"STANDARD\",\n  \"voucherCode\": \"XIII120\",\n  \"paymentMethod\": \"COD\"\n}"
            },
            "url": "{{baseUrl}}/checkout/create"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j=pm.response.json(); if(j.data?.orderCode) pm.collectionVariables.set('orderCode', j.data.orderCode);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/orders/{{orderCode}}"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Provider availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/providers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "providers"
              ]
            }
          }
        },
        {
          "name": "Create online payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderCode\": \"XIII-REPLACE\",\n  \"provider\": \"MOMO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "create"
              ]
            }
          }
        },
        {
          "name": "Buyer payment status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/order/XIII-REPLACE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "order",
                "XIII-REPLACE"
              ]
            }
          }
        },
        {
          "name": "VNPAY IPN endpoint (provider calls this)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/webhooks/vnpay",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "webhooks",
                "vnpay"
              ]
            }
          }
        }
      ]
    }
  ]
}