# XIII Marketplace — STAGING ONLY
# Copy to .env.staging on the staging host. Never commit the real file.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
APP_RELEASE=staging-local

# Compose uses a private single-node Mongo replica set for staging.
MONGODB_URI=mongodb://mongodb:27017/xiii_marketplace_staging?replicaSet=rs0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=2

REDIS_PASSWORD=REPLACE_WITH_32_PLUS_RANDOM_CHARS
REDIS_URL=redis://:REPLACE_WITH_32_PLUS_RANDOM_CHARS@redis:6379/0
REQUIRE_REDIS=true

JWT_ACCESS_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_PLUS_RANDOM_CHARS
PAYOUT_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_PLUS_RANDOM_CHARS

# Public staging URLs. Use HTTPS through a CDN/load balancer/reverse proxy.
STAGING_WEB_HOST=shop-staging.example.com
STAGING_SELLER_HOST=seller-staging.example.com
STAGING_ADMIN_HOST=admin-staging.example.com
STAGING_API_HOST=api-staging.example.com

WEB_URL=https://shop-staging.example.com
SELLER_URL=https://seller-staging.example.com
ADMIN_URL=https://admin-staging.example.com
API_PUBLIC_URL=https://api-staging.example.com
NEXT_PUBLIC_WEB_URL=https://shop-staging.example.com
NEXT_PUBLIC_SELLER_URL=https://seller-staging.example.com
NEXT_PUBLIC_API_URL=https://api-staging.example.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api-staging.example.com
CORS_ORIGINS=https://shop-staging.example.com,https://seller-staging.example.com,https://admin-staging.example.com
TRUST_PROXY=true
HTTP_JSON_LIMIT=1mb
HTTP_FORM_LIMIT=1mb
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

# Staging should use a separate bucket/account from production.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://YOUR_STAGING_S3_ENDPOINT
STORAGE_REGION=auto
STORAGE_BUCKET=xiii-media-staging
STORAGE_ACCESS_KEY_ID=REPLACE_ME
STORAGE_SECRET_ACCESS_KEY=REPLACE_ME
STORAGE_PUBLIC_BASE_URL=https://cdn-staging.example.com
STORAGE_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_URL_TTL_SECONDS=300

# Payment sandbox credentials only. Never put production merchant secrets in staging.
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REQUEST_TYPE=captureWallet
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Docker image tag. deploy.sh overrides this with the git SHA unless explicitly supplied.
IMAGE_TAG=staging
IMAGE_PREFIX=xiii-marketplace

# AI outfit pilot: server only, explicitly opt in.
AI_OUTFIT_ENABLED=false
OPENAI_API_KEY=
AI_OUTFIT_MODEL=gpt-image-1.5
AI_OUTFIT_DAILY_LIMIT=10
