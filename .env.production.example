NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
MONGODB_URI=mongodb://xiii-app:REPLACE_ME@mongodb1:27017,mongodb2:27017,mongodb3:27017/xiii_marketplace?replicaSet=rs0&authSource=xiii_marketplace
REDIS_PASSWORD=REPLACE_WITH_LONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_LONG_REDIS_PASSWORD@redis:6379/0
REQUIRE_REDIS=true

JWT_ACCESS_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_PLUS_RANDOM_CHARS
PAYOUT_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_PLUS_RANDOM_CHARS

WEB_URL=https://xiii.example.com
SELLER_URL=https://seller.xiii.example.com
ADMIN_URL=https://admin.xiii.example.com
API_PUBLIC_URL=https://api.xiii.example.com
NEXT_PUBLIC_WEB_URL=https://xiii.example.com
NEXT_PUBLIC_SELLER_URL=https://seller.xiii.example.com
NEXT_PUBLIC_API_URL=https://api.xiii.example.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.xiii.example.com
CORS_ORIGINS=https://xiii.example.com,https://seller.xiii.example.com,https://admin.xiii.example.com
TRUST_PROXY=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=xiii-media
STORAGE_ACCESS_KEY_ID=REPLACE_ME
STORAGE_SECRET_ACCESS_KEY=REPLACE_ME
STORAGE_PUBLIC_BASE_URL=https://cdn.xiii.example.com
STORAGE_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_URL_TTL_SECONDS=300

MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REQUEST_TYPE=captureWallet
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# AI outfit pilot: server only, explicitly opt in.
AI_OUTFIT_ENABLED=false
OPENAI_API_KEY=
AI_OUTFIT_MODEL=gpt-image-1.5
AI_OUTFIT_DAILY_LIMIT=10
